# Phase B telemetry — copy to .env.local (gitignored) for dev builds.
# API key must match peq-tools-eml-viewer-telemetry-config in Secret Manager:
#   gcloud secrets versions access latest \
#     --secret=peq-tools-eml-viewer-telemetry-config --project=peq-tools

VITE_TELEMETRY_URL=https://eml-viewer-telemetry-184555541545.us-central1.run.app/v1/eml-viewer/telemetry
VITE_TELEMETRY_API_KEY=dev-key-change-me

# Email to myself — must be a Chrome Extension OAuth client (NOT Web).
# Item ID = chrome://extensions ID. See docs/EMAIL_TO_SELF.md
# VITE_GOOGLE_OAUTH_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
